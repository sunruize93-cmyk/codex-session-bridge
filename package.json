{
  "name": "codex-session-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小红书与微信的本地会话操作插件",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0 <25"
