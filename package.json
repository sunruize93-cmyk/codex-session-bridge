{
  "name": "codex-session-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "小红书、Instagram 与实验微信的本地会话操作插件",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "doctor": "node server/dist/cli.js doctor",
    "package": "node scripts/package.mjs",
    "format": "prettier --write server/src tests scripts/*.mjs *.json *.md docs skills .codex-plugin .agents .github",
    "format:check": "prettier --check server/src tests scripts/*.mjs *.json *.md docs skills .codex-plugin .agents .github"
  },
  "dependencies": {
    "@jackwener/opencli": "2.0.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.7",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
